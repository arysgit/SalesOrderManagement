@model FrontEnd.Models.OrderFormModel
@{ ViewData["Title"] = Model.Id is null ? "Add Order" : "Edit Order"; }
<h1 class="mb-4">@ViewData["Title"]</h1>
<form asp-action="Save" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="text-danger mb-3"></div><div class="row g-3 mb-4"><div class="col-md-4"><label asp-for="SoNo" class="form-label">Order Number</label><input asp-for="SoNo" class="form-control" readonly="@(Model.Id is not null)" /></div><div class="col-md-3"><label asp-for="OrderDate" class="form-label">Order Date</label><input asp-for="OrderDate" type="date" class="form-control" /></div><div class="col-md-5"><label asp-for="CustomerId" class="form-label">Customer</label><select asp-for="CustomerId" class="form-select"><option value="">Pilih customer</option>@foreach (var customer in Model.Customers) { <option value="@customer.CustomerId">@customer.CustomerName</option> }</select></div><div class="col-12"><label asp-for="Address" class="form-label">Address</label><textarea asp-for="Address" class="form-control" rows="2"></textarea></div></div><div class="d-flex justify-content-between align-items-center mb-2"><h2 class="h5">Line Items</h2><button type="button" class="btn btn-sm btn-outline-secondary" onclick="addItem()">+ Add line</button></div><div class="table-responsive"><table class="table" id="items"><thead><tr><th>Item Name</th><th style="width: 130px">QTY</th><th style="width: 180px">Price</th><th style="width: 80px"></th></tr></thead><tbody>@for (var i = 0; i < Model.Items.Count; i++) { <tr><td><input name="Items[@i].ItemName" value="@Model.Items[i].ItemName" class="form-control" /></td><td><input name="Items[@i].Quantity" value="@Model.Items[i].Quantity" type="number" min="1" class="form-control" /></td><td><input name="Items[@i].Price" value="@Model.Items[i].Price" type="number" min="0.01" step="0.01" class="form-control" /></td><td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()">Remove</button></td></tr> }</tbody></table></div><div class="mt-4"><a asp-action="Index" class="btn btn-light">Cancel</a> <button class="btn btn-primary">Save Order</button></div></form>
@section Scripts { <script>function addItem(){const body=document.querySelector('#items tbody');const i=body.rows.length;const row=body.insertRow();row.innerHTML=`<td><input name="Items[${i}].ItemName" class="form-control" /></td><td><input name="Items[${i}].Quantity" type="number" min="1" class="form-control" /></td><td><input name="Items[${i}].Price" type="number" min="0.01" step="0.01" class="form-control" /></td><td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()">Remove</button></td>`;}</script> }
